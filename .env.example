# ==============================================================================
# Moc Huong Shop Microservices — Sample Environment Variables (Lab / Sandbox)
# Copy this file to .env if overriding defaults locally. Never commit .env!
# ==============================================================================

# PostgreSQL (4 separate databases: identity_db, catalog_db, order_db, notification_db)
POSTGRES_USER=mochuong
POSTGRES_PASSWORD=mochuong_dev_pass

# JWT HMAC-SHA256 Secret (minimum 32 bytes / 256 bits)
JWT_SECRET=moc-huong-shop-super-secret-jwt-key-minimum-32-bytes-long-2026
JWT_EXPIRATION_MS=86400000

# Demo seeded user password for local lab testing only
DEMO_USER_PASSWORD=MocHuong@123

# Order Outbox Relay interval
OUTBOX_POLL_INTERVAL_MS=2000

# OpenTelemetry (Disabled by default locally; set OTEL_EXPORT_ENABLED=true when Collector runs)
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORT_ENABLED=false
TRACING_SAMPLING_PROBABILITY=1.0
